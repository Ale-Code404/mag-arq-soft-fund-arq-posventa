e=6;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;container=1;pointerEvents=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="500" y="300" width="300" height="420" as="geometry"/></mxCell><mxCell id="x1" value="&lt;b&gt;Proveedor de identidad&lt;/b&gt;&lt;div&gt;[Sistema externo]&lt;/div&gt;&lt;br&gt;&lt;div&gt;Envía y valida el código de un solo uso al correo.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;" vertex="1" parent="b2"><mxGeometry x="30" y="30" width="240" height="120" as="geometry"/></mxCell><mxCell id="x2" value="&lt;b&gt;Sistema de Posventa&lt;/b&gt;&lt;div&gt;[Sistema existente]&lt;/div&gt;&lt;br&gt;&lt;div&gt;Fuente de propietarios y solicitudes. Expone dos consultas de solo lectura.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;" vertex="1" parent="b2"><mxGeometry x="30" y="230" width="240" height="120" as="geometry"/></mxCell><mxCell id="r1" value="&lt;b&gt;Usa&lt;/b&gt;&lt;div&gt;[HTTPS]&lt;/div&gt;" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;endFill=1;strokeColor=#828282;endSize=14;rounded=0;" edge="1" parent="1" source="p1" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r2" value="&lt;b&gt;Inicia sesión&lt;/b&gt;" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;endFill=1;strokeColor=#828282;endSize=14;rounded=0;" edge="1" parent="1" source="c1" target="x1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r3" value="&lt;b&gt;Consulta solicitudes&lt;/b&gt;" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;endFill=1;strokeColor=#828282;endSize=14;rounded=0;" edge="1" parent="b1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r4" value="&lt;b&gt;Busca propietario y lee solicitudes&lt;/b&gt;&lt;div&gt;[solo lectura]&lt;/div&gt;" style="endArrow=blockThin;html=1;fontSize=11;fontColor=#404040;endFill=1;strokeColor=#828282;endSize=14;rounded=0;" edge="1" parent="1" source="c2" target="x2"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
